  "components": {
    "securitySchemes": {
      "PassengerCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gza_session",
        "description": "Host-only HTTP-only Secure cookie for passenger account realm (Path=/api/v1)"
      },
      "StaffCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gza_staff_session",
        "description": "Host-only HTTP-only Secure cookie for staff administration realm (Path=/api/v1)"
      },
      "BookingGuestGrantAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Booking-Token",
        "description": "Short-lived (15 min) opaque token issued after successful contact-channel OTP verification, bound strictly to a single booking PNR"
      },
      "WebhookSignatureAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Signature",
        "description": "HMAC-SHA256 signature calculated over raw request payload using configured payment provider secret"
      },
      "StaffPreAuthCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gza_staff_pending",
        "description": "Host-only HTTP-only Secure cookie for pending staff MFA / enrollment authority (Path=/api/v1, Max-Age=300)"
      },
      "BookingReceiptGrantAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Booking-Receipt",
        "description": "Short-lived (10 min) opaque token issued at booking creation, bound strictly to a single booking PNR for minimal receipt retrieval"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "$ref": "#/components/schemas/ErrorPayload"
          },
          "meta": {
            "$ref": "#/components/schemas/ReferenceMeta"
          }
        }
      },
      "ErrorPayload": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ReferenceMeta": {
        "type": "object",
        "required": [
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "MailSettingsDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "configured": {
            "type": "boolean"
          },
          "driver": {
            "type": "string",
            "enum": [
              "capture",
              "smtp"
            ]
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "tls": {
            "type": "string",
            "enum": [
              "none",
              "starttls",
              "tls"
            ]
          },
          "usernameSet": {
            "type": "boolean"
          },
          "passwordSet": {
            "type": "boolean"
          },
          "senderName": {
            "type": "string"
          },
          "senderEmail": {
            "type": "string"
          },
          "replyTo": {
            "type": "string"
          }
        },
        "required": [
          "revision",
          "configured",
          "driver",
          "host",
          "port",
          "tls",
          "usernameSet",
          "passwordSet",
          "senderName",
          "senderEmail",
          "replyTo"
        ]
      },
      "SaveMailSettingsRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "driver": {
            "type": "string",
            "enum": [
              "capture",
              "smtp"
