  "components": {
    "schemas": {
      "CatalogOption": {
        "type": "object",
        "required": ["id", "label", "active", "order"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "label": {
            "type": "object",
            "required": ["en", "ar"],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "ar": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "active": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ReferenceMeta": {
        "type": "object",
        "required": ["requestId", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "ErrorPayload": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "error", "meta"],
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [false]
          },
          "error": {
            "$ref": "#/components/schemas/ErrorPayload"
          },
          "meta": {
            "$ref": "#/components/schemas/ReferenceMeta"
          }
        }
      },
      "MealsSnapshotData": {
        "type": "object",
        "required": ["revision", "meals", "defaultMealId"],
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "meals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            }
          },
          "defaultMealId": {
            "type": ["string", "null"]
          }
        }
      },
      "MealsSnapshotResponse": {
        "type": "object",
        "required": ["success", "data", "meta"],
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "data": {
            "$ref": "#/components/schemas/MealsSnapshotData"
          },
          "meta": {
            "$ref": "#/components/schemas/ReferenceMeta"
          }
        }
      },
      "OptionMutationReceiptData": {
        "type": "object",
        "required": ["result", "changed"],
        "additionalProperties": false,
        "properties": {
          "result": {
            "$ref": "#/components/schemas/CatalogOption"
          },
          "changed": {
            "type": "boolean"
          }
        }
      },
      "OptionMutationReceiptResponse": {
        "type": "object",
        "required": ["success", "data", "meta"],
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "data": {
            "$ref": "#/components/schemas/OptionMutationReceiptData"
          },
          "meta": {
            "$ref": "#/components/schemas/ReferenceMeta"
          }
        }
      },
      "SnapshotMutationReceiptData": {
        "type": "object",
        "required": ["result", "changed"],
        "additionalProperties": false,
        "properties": {
          "result": {
            "$ref": "#/components/schemas/MealsSnapshotData"
          },
          "changed": {
            "type": "boolean"
          }
        }
      },
      "SnapshotMutationReceiptResponse": {
        "type": "object",
        "required": ["success", "data", "meta"],
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "data": {
            "$ref": "#/components/schemas/SnapshotMutationReceiptData"
          },
          "meta": {
            "$ref": "#/components/schemas/ReferenceMeta"
          }
        }
      },
      "CreateMealRequest": {
        "type": "object",
        "required": ["id", "label", "active"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "label": {
            "type": "object",
            "required": ["en", "ar"],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "ar": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "active": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PatchMealRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "object",
            "required": ["en", "ar"],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "ar": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "active": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ReorderMealsRequest": {
        "type": "object",
        "required": ["ids"],
        "additionalProperties": false,
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SetDefaultMealRequest": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
