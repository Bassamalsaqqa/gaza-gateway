{
  "openapi": "3.1.0",
  "info": {
    "title": "Gaza Gateway - MVP Offerings and Recurring Schedules API",
    "description": "Backend curated recurring schedule authority and pure dated offering projection",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/schedules": {
      "get": {
        "operationId": "getSchedules",
        "tags": ["Reference: Schedules"],
        "summary": "Get active recurring source schedules",
        "security": [],
        "x-authority-policy": "public",
        "responses": {
          "200": {
            "description": "Active recurring source schedules list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchedulesSnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or rejected host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/schedules": {
      "get": {
        "operationId": "getAdminSchedules",
        "tags": ["Reference: Schedules"],
        "summary": "Get full staff source schedules catalog",
        "security": [
          {
            "StaffCookieAuth": []
          }
        ],
        "x-required-permission": "ops.view",
        "responses": {
          "200": {
            "description": "Full staff recurring source schedules list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchedulesSnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or rejected host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or missing staff session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden or insufficient role permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postAdminSchedule",
        "tags": ["Reference: Schedules"],
        "summary": "Create a new recurring schedule entry",
        "security": [
          {
            "StaffCookieAuth": []
          }
        ],
        "x-required-permission": "ops.edit",
        "x-protocol": {
          "branches": [
            {
              "csrf": "staff",
              "origin": "configured_frontend"
            }
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleCreateInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Schedule created receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleReceiptResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed payload or rejected host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or missing staff session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden, missing CSRF or disallowed origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Schedule with same ID already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error or inactive dependency activation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/schedules/{key}": {
      "patch": {
        "operationId": "patchAdminSchedule",
        "tags": ["Reference: Schedules"],
        "summary": "Update an existing recurring schedule by opaque route key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Canonical opaque sch1- prefix base64url encoded schedule ID",
            "schema": {
              "type": "string",
              "pattern": "^sch1-[A-Za-z0-9_-]+$"
            }
          }
        ],
        "security": [
          {
            "StaffCookieAuth": []
          }
        ],
        "x-required-permission": "ops.edit",
        "x-protocol": {
          "branches": [
            {
              "csrf": "staff",
              "origin": "configured_frontend"
            }
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Schedule patched receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleReceiptResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed payload or rejected host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or missing staff session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden, missing CSRF or disallowed origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Schedule not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error or immutable route identity modification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/offerings": {
      "get": {
        "operationId": "getOfferings",
        "tags": ["Reference: Offerings"],
        "summary": "Get active dated offering projection for target date",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Target calendar date in ISO format (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            }
          },
          {
            "name": "origin",
            "in": "query",
            "required": false,
            "description": "Origin IATA airport code",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": false,
            "description": "Destination IATA airport code",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "description": "Flight direction",
            "schema": {
              "type": "string",
              "enum": ["out", "in"]
            }
          }
        ],
        "security": [],
        "x-authority-policy": "public",
        "responses": {
          "200": {
            "description": "Active dated offerings list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferingsListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or rejected host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid date or query filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/offerings/{id}": {
      "get": {
        "operationId": "getOfferingById",
        "tags": ["Reference: Offerings"],
        "summary": "Get exact dated offering detail by deterministic identifier",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Exact dated offering identifier svc1-<base64url>-YYYY-MM-DD",
            "schema": {
              "type": "string",
              "pattern": "^svc1-[A-Za-z0-9_-]+-\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            }
          }
        ],
        "security": [],
        "x-authority-policy": "public",
        "responses": {
          "200": {
            "description": "Dated offering detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferingDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or rejected host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Offering not found or currently unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "StaffCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gza_staff_session",
        "description": "Persisted authenticated staff session token"
      }
    },
    "schemas": {
      "SuccessMeta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": ["requestId", "timestamp"]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"]
          },
          "meta": {
            "$ref": "#/components/schemas/SuccessMeta"
          }
        },
        "required": ["success", "error", "meta"]
      },
      "ScheduleExceptionEffectCancelled": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cancelled": {
            "type": "boolean",
            "const": true
          }
        },
        "required": ["cancelled"]
      },
      "ScheduleExceptionEffectTime": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "departTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "arriveTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        },
        "required": ["departTime", "arriveTime"]
      },
      "ScheduleExceptionEffectAircraft": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aircraftId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "aircraft": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": ["aircraftId", "aircraft"]
      },
      "ScheduleExceptionEffectExtra": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "departTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "arriveTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "aircraftId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "aircraft": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "ScheduleExceptionDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "kind": {
            "type": "string",
            "enum": ["cancelled", "time", "aircraft", "extra"]
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          },
          "effect": {
            "oneOf": [
              { "$ref": "#/components/schemas/ScheduleExceptionEffectCancelled" },
              { "$ref": "#/components/schemas/ScheduleExceptionEffectTime" },
              { "$ref": "#/components/schemas/ScheduleExceptionEffectAircraft" },
              { "$ref": "#/components/schemas/ScheduleExceptionEffectExtra" }
            ]
          }
        },
        "required": ["id", "date", "kind", "detail"]
      },
      "ScheduleDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "number": {
            "type": "string",
            "pattern": "^[A-Z]{2}\\s?[0-9]{1,4}$"
          },
          "direction": {
            "type": "string",
            "enum": ["out", "in"]
          },
          "destination": {
            "type": "string",
            "enum": ["AMM", "CAI", "IST", "DOH", "DXB", "JED", "RUH"]
          },
          "days": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "minItems": 1,
            "maxItems": 7
          },
          "departTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "arriveTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "aircraft": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "aircraftId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "until": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "active": {
            "type": "boolean"
          },
          "exceptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleExceptionDto"
            },
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "number",
          "direction",
          "destination",
          "days",
          "departTime",
          "arriveTime",
          "aircraft",
          "from",
          "until",
          "active",
          "exceptions"
        ]
      },
      "ScheduleCreateInput": {
        "$ref": "#/components/schemas/ScheduleDto"
      },
      "ScheduleUpdateInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[A-Z]{2}\\s?[0-9]{1,4}$"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "minItems": 1,
            "maxItems": 7
          },
          "departTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "arriveTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "aircraft": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "aircraftId": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "until": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "active": {
            "type": "boolean"
          },
          "exceptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleExceptionDto"
            },
            "maxItems": 100
          }
        }
      },
      "SeatLayoutDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aircraftId": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "letters": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]$"
            }
          },
          "aisleAfter": {
            "type": "integer",
            "minimum": 1
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "enum": ["economy", "premium", "business"]
                },
                "firstRow": {
                  "type": "integer",
                  "minimum": 1
                },
                "lastRow": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["id", "firstRow", "lastRow"]
            }
          },
          "extraLegroomRows": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "unavailable": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "aircraftId",
          "rows",
          "letters",
          "aisleAfter",
          "zones",
          "extraLegroomRows",
          "unavailable"
        ]
      },
      "OfferingDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^svc1-[A-Za-z0-9_-]+-\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "scheduleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "number": {
            "type": "string",
            "pattern": "^[A-Z]{2}\\s?[0-9]{1,4}$"
          },
          "direction": {
            "type": "string",
            "enum": ["out", "in"]
          },
          "originCode": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "destinationCode": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "departTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "arriveTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1
          },
          "aircraftId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "aircraft": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "layout": {
            "$ref": "#/components/schemas/SeatLayoutDto"
          },
          "revisions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fleet": {
                "type": "integer",
                "minimum": 0
              },
              "network": {
                "type": "integer",
                "minimum": 0
              },
              "schedules": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["fleet", "network", "schedules"]
          },
          "classification": {
            "type": "string",
            "const": "commemorative"
          },
          "priceMinor": {
            "type": "integer",
            "const": 0
          }
        },
        "required": [
          "id",
          "scheduleId",
          "date",
          "number",
          "direction",
          "originCode",
          "destinationCode",
          "departTime",
          "arriveTime",
          "durationMinutes",
          "aircraftId",
          "aircraft",
          "layout",
          "revisions",
          "classification",
          "priceMinor"
        ]
      },
      "ScheduleReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schedule": {
            "$ref": "#/components/schemas/ScheduleDto"
          },
          "changed": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "schedule",
          "changed",
          "revision"
        ]
      },
      "ScheduleReceiptResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/ScheduleReceipt"
          },
          "meta": {
            "$ref": "#/components/schemas/SuccessMeta"
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      },
      "SchedulesSnapshotResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/SuccessMeta"
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      },
      "OfferingsListResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferingDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/SuccessMeta"
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      },
      "OfferingDetailResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/OfferingDto"
          },
          "meta": {
            "$ref": "#/components/schemas/SuccessMeta"
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      }
    }
  }
}
