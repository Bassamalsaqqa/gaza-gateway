{
  "openapi": "3.1.0",
  "info": {
    "title": "Gaza Gateway live Admin read projections",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/admin/dashboard": {
      "get": {
        "operationId": "getAdminDashboard",
        "security": [
          {
            "StaffCookieAuth": []
          }
        ],
        "x-required-permission": "dashboard.view",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            }
          },
          "400": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/customers": {
      "get": {
        "operationId": "getAdminCustomers",
        "security": [
          {
            "StaffCookieAuth": []
          }
        ],
        "x-required-permission": "commercial.view",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999,
              "default": 1
            }
          }
        ]
      }
    },
    "/admin/activity": {
      "get": {
        "operationId": "getAdminActivity",
        "security": [
          {
            "StaffCookieAuth": []
          }
        ],
        "x-required-permission": "admin.manage",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Canonical error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999,
              "default": 1
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "StaffCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gza_staff_session"
      }
    },
    "schemas": {
      "DashboardResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "confirmedBookings": {
                "type": "integer",
                "minimum": 0
              },
              "confirmedPassengers": {
                "type": "integer",
                "minimum": 0
              },
              "cancelledBookings": {
                "type": "integer",
                "minimum": 0
              },
              "passengerAccounts": {
                "type": "integer",
                "minimum": 0
              },
              "activeDestinations": {
                "type": "integer",
                "minimum": 0
              },
              "activeAircraft": {
                "type": "integer",
                "minimum": 0
              },
              "activeSchedules": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "confirmedBookings",
              "confirmedPassengers",
              "cancelledBookings",
              "passengerAccounts",
              "activeDestinations",
              "activeAircraft",
              "activeSchedules"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "requestId",
              "timestamp"
            ]
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      },
      "CustomersResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "phone": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "unverified",
                        "suspended"
                      ]
                    },
                    "bookingCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "email",
                    "phone",
                    "status",
                    "bookingCount",
                    "createdAt"
                  ]
                }
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "pageSize": {
                "type": "integer",
                "const": 25
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "items",
              "page",
              "pageSize",
              "total"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "requestId",
              "timestamp"
            ]
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      },
      "ActivityResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "domain": {
                      "type": "string",
                      "enum": [
                        "identity",
                        "fleet",
                        "network",
                        "meals",
                        "schedules",
                        "content",
                        "gallery",
                        "reservations",
                        "contact"
                      ]
                    },
                    "action": {
                      "type": "string"
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "success",
                        "failure",
                        "denied"
                      ]
                    },
                    "actorId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "targetId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "occurredAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "domain",
                    "action",
                    "outcome",
                    "actorId",
                    "targetId",
                    "occurredAt"
                  ]
                }
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "pageSize": {
                "type": "integer",
                "const": 25
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "items",
              "page",
              "pageSize",
              "total"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "requestId",
              "timestamp"
            ]
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "requestId",
              "timestamp"
            ]
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ]
      }
    }
  }
}
