{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreeReservationCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submissionId",
    "serviceId",
    "passengers",
    "contact"
  ],
  "properties": {
    "submissionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^svc1-[A-Za-z0-9_-]+-\\d{4}-\\d{2}-\\d{2}(?![\\s\\S])"
    },
    "passengers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "firstName",
          "lastName",
          "dob",
          "nationality",
          "document",
          "seatCode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
          },
          "type": {
            "enum": [
              "adult",
              "child"
            ]
          },
          "firstName": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          },
          "lastName": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "nationality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "document": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "seatCode": {
            "type": "string",
            "pattern": "^(?:[1-9]|[1-5][0-9]|60)[A-Z](?![\\s\\S])"
          },
          "mealId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email",
        "phone"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        }
      }
    }
  },
  "$comment": "Dormant command foundation. App\\Mvp\\Reservations\\ReservationCommand enforces age/calendar/codec/party uniqueness. The future transactional coordinator must validate live ownership, verified account, active service/meal, physical seats, occupancy and idempotency. No endpoint is enabled by this schema."
}
