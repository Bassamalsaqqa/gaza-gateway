# Private runtime template ONLY: save completed copy outside public_html with mode 0600.
# Do not upload this example as a working configuration. Generate distinct private random values.
APP_NAME="Gaza Gateway"
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
APP_URL=https://www.gazaairport.com
APP_ALLOWED_HOSTS=www.gazaairport.com,gazaairport.com
CORS_ALLOWED_ORIGINS=https://www.gazaairport.com,https://gazaairport.com
APP_COMMIT=REPLACE_WITH_EXACT_RELEASE_SOURCE_SHA
HOSTPAPA_SHARED_ENABLED=true
HOSTPAPA_CRON_CADENCE_MINUTES=15
REFERENCE_ENABLED=true
MEALS_ENABLED=true
SCHEDULES_ENABLED=true
RESERVATIONS_ENABLED=true
EDITORIAL_ENABLED=true
GALLERY_ENABLED=true
MVP_SITE_ENABLED=true
MVP_MAIL_ENABLED=true
MVP_IDENTITY_SMTP_ENABLED=true
MVP_SMTP_ALLOWED_HOSTS=mail.gazaairport.com
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_OWNER_DATABASE
DB_USERNAME=REPLACE_WITH_RUNTIME_DML_USER
DB_PASSWORD="REPLACE_WITH_PRIVATE_RUNTIME_PASSWORD"
DB_STRICT=true
DB_TIMEZONE=+00:00
DB_ISOLATION_LEVEL="READ COMMITTED"
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT=3000
DB_LOCK_TIMEOUT=3000
CACHE_STORE=database
QUEUE_CONNECTION=database
FOUNDATION_MAIL_DRIVER=unconfigured
FOUNDATION_STORAGE_DRIVER=local
LOG_CHANNEL=single
LOG_LEVEL=info
GUEST_OTP_PEPPER_BASE64=REPLACE_WITH_SEPARATE_BASE64_32_RANDOM_BYTES
GUEST_OTP_PEPPER_VERSION=1
# SMTP password is supplied privately to bootstrap/admin and stored encrypted in MySQL, never in this file.
