APP_NAME="Gaza Gateway API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:18084

APP_VERSION=1.0.0-foundation
APP_COMMIT=unreleased-local
APP_SCHEMA_VERSION=1

APP_ALLOWED_HOSTS=127.0.0.1,localhost,127.0.0.1:18084,localhost:18084
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://127.0.0.1:18084,http://localhost:3000,http://127.0.0.1:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gaza_gateway_dev
DB_TEST_DATABASE=gaza_gateway_test
DB_USERNAME=gaza_app_user
DB_PASSWORD=gaza_app_local_pass

CACHE_STORE=database
CACHE_PREFIX=gza_cache

QUEUE_CONNECTION=database

SESSION_DRIVER=array

HASHING_DRIVER=argon2id
HASHING_ARGON2ID_MEMORY=65536
HASHING_ARGON2ID_TIME=4
HASHING_ARGON2ID_THREADS=1
